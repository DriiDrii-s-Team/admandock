{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^(?!)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*ng serve.*$",
          "endsPattern": "^\\s*(?:➜\\s+)?Local:\\s+http://localhost:4200/.*$"
        }
      }
    }
  ]
}
